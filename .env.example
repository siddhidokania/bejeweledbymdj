# Copy to .env.local and fill in. Set the same values in Vercel → Project → Settings → Environment Variables.

# Sanity
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
# Token with Editor access (creates orders/reviews, reads private order data). Server-only.
SANITY_WRITE_TOKEN=
# Secret configured on the order-status webhook in sanity.io/manage → API → Webhooks
SANITY_WEBHOOK_SECRET=

# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/account
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/account

# Resend
RESEND_API_KEY=
# Leave blank until a domain is verified in Resend; then e.g. "BeJeweled <orders@yourdomain.in>".
# While blank, all emails go to SHOP_EMAIL instead of customers.
EMAIL_FROM=
# Receives contact-form messages and a copy of every new order
SHOP_EMAIL=

# Public address of the site (used in emails, sitemap, share previews)
NEXT_PUBLIC_SITE_URL=https://bejeweledbymdj.vercel.app
